# Required
ANTHROPIC_API_KEY=sk-ant-...

# Optional — if not set, uses household.json file fallback
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Optional — if not set, uses in-memory Map for session state
REDIS_URL=redis://...

